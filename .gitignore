.env
__pycache__/
*.py[cod]
.DS_Store
CLAUDE.local.md
.cache/
.venv/

# The catalog: 60 MB, re-downloadable from the official release.
# sha256 da979b05a68af864cb0dcf9ee6a81c010c7e66a57978ad286c7a2e005fc69a67
# Kept out of git to avoid GitHub's >50 MB warning on the public submission repo.
data/catalog.jsonl

# Run outputs. The registry and the split manifest ARE committed — they are the record every
# held-out number depends on. Raw dumps and progress logs are not.
# ⚠️ `runs/*` not `runs/`: git cannot un-ignore a file inside an ignored DIRECTORY, only inside an
# ignored glob. holdout.json was silently ignored for a while precisely because of this.
runs/*
!runs/registry.jsonl
!runs/holdout.json
!runs/final_r5.json

# --- restored after commit 7779b6b resolved a merge conflict by dropping the local side ---
# Catalog: 60 MB, re-downloadable from the official release and verified by assets/SHA256SUMS.
# Keeping it out avoids GitHub's >50 MB warning on the public submission repo.
assets/catalog.jsonl
assets/catalog.jsonl.gz

# Derived artifacts: regenerable (scripts/embed_all.py ~14 min; scripts/embed_blair.py ~5 min).
# emb.npy is 98 MB and blair.npz 71 MB — neither may ever enter git history.
artifacts/

# ...but the split manifest IS the lock on every held-out number, so it stays tracked.
!runs/holdout.json
